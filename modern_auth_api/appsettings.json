{
  //"Logging": {
  //  "LogLevel": {
  //    "Default": "Information",
  //    "Microsoft.AspNetCore": "Warning"
  //  }
  //},
    "Serilog": {
      "MinimumLevel": {
        "Default": "Information",
        "Override": {
          "Microsoft.AspNetCore": "Warning"
        }
      },
      "Enrich": [ "FromLogContext" ],
      "WriteTo": [
        {
          "Name": "Console"
        }
      ]
    },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "<secrets>"
  },
  "SecurityKey": "<secrets>"
}